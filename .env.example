# Das gemeinsame Passwort für die Seite. Ohne diese Variable läuft die App nicht.
APP_PASSWORD=

# Passwort für die Gastansicht: alles sichtbar, nichts änderbar. Bleibt es
# leer, gibt es keine Gastansicht.
GUEST_PASSWORD=

# Optional. Signiert die Session-Cookies. Wird sie weggelassen, leitet die App
# den Schlüssel aus APP_PASSWORD ab – dann meldet ein Passwortwechsel alle ab,
# was meistens genau richtig ist. Zum Erzeugen:  openssl rand -hex 32
SESSION_SECRET=

# Redis und Ablage für Fotos, Videos und Kartenbilder. Lokal reichen die
# Vorgaben; auf dem Server setzt setup-server.sh DATA_DIR=/srv/passeranking/data.
REDIS_URL=redis://127.0.0.1:6379
DATA_DIR=.data
PORT=3000

# Für den Foto-Import vom Handy. Der Kurzbefehl weist sich damit aus:
#   Authorization: Bearer <UPLOAD_TOKEN>
# Erzeugen mit:  openssl rand -hex 32
# Er taugt absichtlich nur zum Hochladen, nicht zum Bewerten oder Löschen.
UPLOAD_TOKEN=

# Ab welcher Entfernung ein Foto nicht mehr automatisch zugeordnet wird.
# Meter, Vorgabe 3000.
MATCH_RADIUS_M=3000

# Für die Kartenbilder. Kostenloser Schlüssel von https://www.maptiler.com/
# Fehlt er, bleiben die Kacheln leer, der Rest läuft normal weiter.
MAPTILER_KEY=
MAPTILER_STYLE=outdoor-v2
